    "GNSS fix. Stable over hours, but noisy minute to minute and unavailable indoors.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS-Fix. Über Stunden stabil, aber von Minute zu Minute verrauscht und in Gebäuden nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position GNSS. Stable sur des heures, mais bruitée d'une minute à l'autre et indisponible en intérieur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posición GNSS. Estable durante horas, pero con ruido minuto a minuto y sin cobertura en interiores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione GNSS. Stabile nell'arco di ore, ma rumorosa di minuto in minuto e non disponibile al chiuso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posição GNSS. Estável ao longo de horas, mas oscila de minuto a minuto e não funciona em ambientes fechados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спутниковое определение. Стабильно на протяжении часов, но шумит от минуты к минуте и не работает в помещении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Супутникове визначення. Стабільне протягом годин, але шумить від хвилини до хвилини й не працює в приміщенні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS 測位。数時間単位では安定していますが、分単位ではぶれが大きく、屋内では使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS 측위. 몇 시간 단위로는 안정적이지만 분 단위로는 흔들리고 실내에서는 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS 定位。以小时计很稳定，但分钟级波动明显，室内不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS 定位。以小時來看很穩定，但分鐘間波動明顯，室內無法使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycja GNSS. Stabilna w skali godzin, ale zaszumiona z minuty na minutę i niedostępna w pomieszczeniach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS-positie. Stabiel over uren, maar van minuut tot minuut ruis en binnen niet beschikbaar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS-position. Stabil över timmar men brusig minut för minut, och otillgänglig inomhus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS konumu. Saatler boyunca kararlı, ancak dakikadan dakikaya gürültülü ve iç mekânda kullanılamaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد موقع GNSS. مستقر على مدى ساعات، لكنه مشوّش من دقيقة إلى أخرى وغير متاح داخل المباني."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GNSS फ़िक्स। घंटों में स्थिर, पर मिनट-दर-मिनट अस्थिर और घर के अंदर उपलब्ध नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix GNSS. Stabil selama berjam-jam, tetapi berisik dari menit ke menit dan tidak tersedia di dalam ruangan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณ GNSS เสถียรในระดับชั่วโมง แต่แกว่งในระดับนาทีและใช้ในอาคารไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định vị GNSS. Ổn định qua nhiều giờ, nhưng nhiễu từng phút và không dùng được trong nhà."
          }
        }
      }
    },
