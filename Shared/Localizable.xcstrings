    "Sea-level pressure sits between 800 and 1100 hPa.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Luftdruck auf Meereshöhe liegt zwischen 800 und 1100 hPa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression au niveau de la mer se situe entre 800 et 1100 hPa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presión al nivel del mar está entre 800 y 1100 hPa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione al livello del mare è compresa tra 800 e 1100 hPa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pressão ao nível do mar fica entre 800 e 1100 hPa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давление на уровне моря лежит в пределах 800–1100 hPa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиск на рівні моря лежить у межах 800–1100 hPa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海面気圧は 800〜1100 hPa の範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해면 기압은 800~1100 hPa 사이입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海平面气压介于 800 至 1100 hPa 之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海平面氣壓介於 800 至 1100 hPa 之間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciśnienie na poziomie morza mieści się między 800 a 1100 hPa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De druk op zeeniveau ligt tussen 800 en 1100 hPa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trycket vid havsytan ligger mellan 800 och 1100 hPa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deniz seviyesi basıncı 800 ile 1100 hPa arasındadır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقع ضغط مستوى سطح البحر بين 800 و1100 hPa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुद्र-तल दबाव 800 और 1100 hPa के बीच रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan permukaan laut berkisar antara 800 dan 1100 hPa."
