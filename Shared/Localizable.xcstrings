    "Waiting for a fix. This needs a clear view of the sky.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf Fix. Dafür braucht es freie Sicht zum Himmel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de position. Il faut une vue dégagée du ciel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando posición. Hace falta cielo despejado a la vista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di posizione. Serve una vista libera del cielo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando posição. É preciso ter o céu à vista."
          }
        },
