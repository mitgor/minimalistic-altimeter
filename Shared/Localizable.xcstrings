    "The last altitude, pressure and trip totals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Höhe, Druck und Tour-Summen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière altitude, pression et cumuls du trajet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última altitud, presión y totales de la ruta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima quota, pressione e totali del percorso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
