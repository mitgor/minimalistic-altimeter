    "Theme": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème"
          }
        },
        "es": {
