    "A trailhead sign, a summit marker, a chart — anything you trust.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wegweiser, ein Gipfelkreuz, eine Karte — alles, dem du vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau au départ du sentier, une borne de sommet, une carte — tout ce en quoi vous avez confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cartel al inicio del sendero, un hito de cumbre, un mapa — cualquier cosa en la que confíes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cartello all'inizio del sentiero, un segnale di vetta, una carta — qualunque cosa di cui ti fidi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma placa na trilha, um marco de cume, um mapa — qualquer fonte em que você confie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Табличка на тропе, отметка на вершине, карта — что угодно, чему вы доверяете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табличка на стежці, позначка на вершині, карта — будь-що, чому ви довіряєте."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登山口の標識、山頂の標柱、地図など、信頼できるものなら何でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등산로 입구 표지판, 정상 표석, 지도 등 믿을 수 있는 것이면 무엇이든."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登山口的标牌、山顶的标志、地图——任何你信得过的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登山口的告示牌、山頂的標示、地圖——任何你信得過的來源。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablica na szlaku, znak na szczycie, mapa — cokolwiek, czemu ufasz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bordje bij het beginpunt, een topmarkering, een kaart — alles wat je vertrouwt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En skylt vid leden, en toppmarkering, en karta — vad du än litar på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir patika tabelası, bir zirve işareti, bir harita — güvendiğiniz herhangi bir şey."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لافتة عند بداية المسار، أو علامة قمة، أو خريطة — أي مصدر تثق به."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रेल का साइनबोर्ड, शिखर का चिह्न, नक़्शा — जिस पर भी आप भरोसा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan penunjuk jalur, penanda puncak, peta — apa pun yang Anda percaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้ายต้นทางเดินป่า หลักยอดเขา แผนที่ — อะไรก็ได้ที่คุณเชื่อถือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng chỉ dẫn đầu đường mòn, mốc đỉnh núi, bản đồ — bất cứ gì bạn tin."
          }
        }
      }
    },
