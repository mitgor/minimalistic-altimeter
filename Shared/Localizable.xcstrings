    "Keeps tracking when the app is closed and shows altitude in the Dynamic Island": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst weiter, wenn die App geschlossen ist, und zeigt die Höhe in der Dynamic Island"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de mesurer quand l'app est fermée et affiche l'altitude dans la Dynamic Island"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue midiendo con la app cerrada y muestra la altitud en la Dynamic Island"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a misurare con l'app chiusa e mostra la quota nella Dynamic Island"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua registrando com o app fechado e mostra a altitude na Dynamic Island"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжает измерять при закрытом приложении и показывает высоту в Dynamic Island"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжує вимірювати із закритим застосунком і показує висоту в Dynamic Island"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じても計測を続け、Dynamic Island に高度を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 닫아도 측정을 계속하고 Dynamic Island에 고도를 표시합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭应用后继续记录，并在灵动岛显示海拔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 App 後持續追蹤，並在動態島顯示海拔"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mierzy dalej po zamknięciu aplikacji i pokazuje wysokość w Dynamic Island"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft meten als de app gesloten is en toont de hoogte in het Dynamic Island"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätter mäta när appen är stängd och visar höjden i Dynamic Island"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kapalıyken izlemeyi sürdürür ve yüksekliği Dynamic Island'da gösterir"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل التتبع عند إغلاق التطبيق ويعرض الارتفاع في Dynamic Island"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होने पर भी ट्रैकिंग जारी रखता है और Dynamic Island में ऊँचाई दिखाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus melacak saat aplikasi ditutup dan menampilkan ketinggian di Dynamic Island"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามต่อเมื่อปิดแอป และแสดงความสูงใน Dynamic Island"
