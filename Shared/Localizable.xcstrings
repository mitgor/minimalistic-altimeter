    "Clears the trace, ascent and descent totals, distance, and max speed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Verlauf, Auf- und Abstiegssummen, Distanz und Höchstgeschwindigkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le tracé, les cumuls de montée et de descente, la distance et la vitesse maximale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la traza, los totales de ascenso y descenso, la distancia y la velocidad máxima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la traccia, i totali di salita e discesa, la distanza e la velocità massima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga o traçado, os totais de subida e descida, a distância e a velocidade máxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрасывает график, суммы подъёма и спуска, расстояние и максимальную скорость."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидає графік, суми підйому та спуску, відстань і максимальну швидкість."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレース、累積上昇・下降量、距離、最高速度を消去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적선, 누적 상승·하강량, 거리, 최고 속도를 지웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除轨迹、累计上升与下降量、距离和最高速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除軌跡、累計上升與下降量、距離和最高速度。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyści wykres, sumy podejść i zejść, dystans oraz prędkość maksymalną."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist het spoor, de stijgings- en dalingstotalen, de afstand en de maximumsnelheid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensar kurvan, stignings- och nedstigningssummorna, sträckan och maxfarten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzi, çıkış ve iniş toplamlarını, mesafeyi ve en yüksek hızı siler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح المسار ومجاميع الصعود والهبوط والمسافة والسرعة القصوى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रेस, कुल आरोहण-अवरोहण, दूरी और अधिकतम गति साफ़ करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus grafik, total naik dan turun, jarak, dan kecepatan maksimum."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างเส้นกราฟ ยอดรวมขึ้นและลง ระยะทาง และความเร็วสูงสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa biểu đồ, tổng lên và xuống, quãng đường và tốc độ tối đa."
          }
        }
      }
    },
