          "stringUnit": {
            "state": "translated",
            "value": "Ожидание сигнала. Нужно открытое небо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікування сигналу. Потрібне відкрите небо."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測位待ちです。空が開けた場所が必要です。"
          }
